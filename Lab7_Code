//List of libaries in use, including, ROS, SLAM, BATTERY Sensing, & LED messaging.
#include "ros/ros.h"                  // ROS main library
#include "geometry_msgs/PoseStamped.h" // for sending position goals
#include "actionlib_msgs/GoalID.h"   // for canceling goals
#include "move_base_msgs/MoveBaseActionResult.h" // for result feedback
#include "sensor_msgs/BatteryState.h" // battery voltage readings
#include "std_msgs/Byte.h"           // bumper input
#include <boost/bind.hpp>            // needed for passing extra args to callback
#include "std_msgs/Int32.h"          // for 7-segment LED

// --- Global Variables ---
//Contains bool flags to mark the change in states.
bool goal_reached = false; // becomes true when robot hits goal
bool battery_low = false;  // becomes true when battery is too low
bool bumper_hit = false;   // becomes true when bumper is triggered

//Simple int variables to mark states and the progression between them.
int state = 0;             // current state (0 home, 1 pick, 2 place, 3 low battery)
int last_state = -1;       // used so we don’t resend same goal over and over
int previous_state = 0;    // stores last state before battery interrupt

//Simple int variables to increment the counter of the LED.
int low_counter = 0;       // counts how many times battery is low in a row
int high_counter = 0;      // counts how many times battery is good in a row
int hit_count = 0;         // counts pick/place cycles

// Stop all movement
void stopRobot(ros::Publisher& cancel_pub)
{
    actionlib_msgs::GoalID cancel_msg; // empty message cancels all goals

    cancel_pub.publish(cancel_msg);    // send cancel command

    ROS_WARN("STOP COMMAND SENT: All goals canceled."); // debug message
}

// Robust Send Goal
//Function that publishes to the MR a set of intended grid points to reach within it's SLAM map.
void sendGoal(ros::Publisher& pub, double x, double y, double z, double w)
{
    geometry_msgs::PoseStamped goal; // create goal message

    // Explicitly set these EVERY time
    //Hardcoded map to ensure the MR never deviates from the given map when naviagting.
    goal.header.frame_id = "map"; // use map frame
    goal.header.stamp = ros::Time::now(); // timestamp it

    // Sets the published goals to equal the defined grid points for motion
    goal.pose.position.x = x; // x position
    goal.pose.position.y = y; // y position
    goal.pose.position.z = 0.0; // always 0 for 2D maps

    // Sets orientation of robot
    goal.pose.orientation.z = z;
    goal.pose.orientation.w = w;

    // Reset the global flag before publishing
    goal_reached = false; // reset so we wait for next goal

    // Publish that the MR has reached it's desired goal location.
    pub.publish(goal); // send goal
}

// Callbacks
//A set function to ensure the MR has reached a desired goal.
void resultCallback(const move_base_msgs::MoveBaseActionResult::ConstPtr& msg)
{
    if (msg->status.status == 3) { // 3 means goal reached
        ROS_INFO("Goal Reached."); // Passes back to the user that the goal is reached
        goal_reached = true; // set flag
    }
}

// LowBattery Callback
void batteryCallback(const sensor_msgs::BatteryState::ConstPtr& msg, ros::Publisher& cancel_pub)
{
    float voltage = msg->voltage; // get voltage

    // Count consecutive low readings.
    if (voltage <= 10.5)
    {
        low_counter++; // increase low counter
    }
    else
    {
        low_counter = 0;  // reset if not low
    }

    // Counting the consecutive high readings.
    if (voltage > 10.5)
    {
        high_counter++; // increase high counter
    }
    else
    {
        high_counter = 0;  // reset if not high
    }

    // Confirm LOW only after 10 consecutive readings
    if (low_counter >= 10 && !battery_low)
    {
        ROS_ERROR("LOW BATTERY! Redirecting Home..."); // User output reading.
        battery_low = true; // set flag

        stopRobot(cancel_pub); // stop movement

        state = 3; // go to home/charge
    }
    // Hysteresis: clear only when safely above threshold
    else if (high_counter >= 10 && battery_low)
    {
        ROS_INFO("BATTERY CHARGED"); // User output.

        if(previous_state == 1)
        {
            ROS_INFO("Moving to Pick");
        }
        else if(previous_state == 2)
        {
            ROS_INFO("Moving to Place");
        }

        battery_low = false; // clear flag
        state = previous_state; // go back to what we were doing
    }
}

// Bumper Callback
void bumperCallback(const std_msgs::Byte& msg)
{
    if(msg.data != 0) // if bumper pressed
    {
        bumper_hit = true; // set flag
    }
}

// Start of Main
int main(int argc, char **argv)
{
    ros::init(argc, argv, "goal_manager"); // init node
    ros::NodeHandle n; // create node

    // publishers and subscribers setup

    ros::Publisher goal_pub = n.advertise<geometry_msgs::PoseStamped>("/move_base_simple/goal", 10); // send goals
    ros::Publisher cancel_pub = n.advertise<actionlib_msgs::GoalID>("/move_base/cancel", 1); // cancel goals

    ros::Subscriber res_sub = n.subscribe("/move_base/result", 1, resultCallback); // listen for result
    ros::Subscriber bumper_sub = n.subscribe("bumper", 10, bumperCallback); // bumper input

    ros::Subscriber bat_sub = n.subscribe<sensor_msgs::BatteryState>("/battery_state", 1,
        boost::bind(batteryCallback, _1, boost::ref(cancel_pub))); // battery with cancel pub

    ros::Publisher led_pub = n.advertise<std_msgs::Int32>("led_data", 10); // LED output

    std_msgs::Int32 led_msg; // LED message

    ros::Rate loop_rate(5); // 5 Hz loop
    ros::Duration(3.0).sleep(); // wait before starting

    led_msg.data = hit_count; // start at 0
    led_pub.publish(led_msg);

    while (ros::ok()) {
        ros::spinOnce(); // handle callbacks

        switch (state)
        {
        case 0: // HOME
            if (last_state != state)
            {
                ros::Duration(2.0).sleep(); // small delay

                sendGoal(goal_pub, -3.369, 0.604, -0.823, 0.569); // home coords

                ROS_INFO("Moving to Home...");

                last_state = state;
                previous_state = state;
            }

            if (goal_reached && !battery_low)
            {
                ROS_INFO("Moving to Pick.");
                state = 1;
                last_state = -1;
                goal_reached = false;
                bumper_hit = false;
            }
            break;

        case 1: // PICK
            if (last_state != state)
            {
                sendGoal(goal_pub, -1.062, -0.278, 0.960, 0.279); // pick coords

                last_state = state;
                previous_state = state;
                bumper_hit = false;
            }

            if (goal_reached && bumper_hit)
            {
                ROS_INFO("Pick Success! Moving to Place...");

                goal_reached = false;
                bumper_hit = false;

                state = 2;
                last_state = -1;
            }
            break;

        case 2: // PLACE
            if (last_state != state)
            {
                ros::Duration(2.0).sleep(); // Set MR to wait for the full message

                sendGoal(goal_pub, -0.150, -1.325, -0.233, 0.972); // place coords

                last_state = state;
                previous_state = state;
                bumper_hit = false;
            }

            if (goal_reached && bumper_hit)
            {
                ROS_INFO("Place Success. Returning to Pick...");

                hit_count++; // increase count
                led_msg.data = hit_count;
                led_pub.publish(led_msg); // update LED

                state = 1;
                last_state = -1;
                goal_reached = false;
                bumper_hit = false;
            }
            break;

        case 3: // LOW BATTERY HOME
            if (last_state != state)
            {
                ros::Duration(2.0).sleep();

                sendGoal(goal_pub, -3.369, 0.604, -0.823, 0.569); // go home

                ROS_INFO("Moving to Home...");
                last_state = state;
            }

            if (goal_reached && !battery_low)
            {
                state = previous_state; // resume
                last_state = -1;
                goal_reached = false;
                bumper_hit = false;
            }
            break;
        }

        loop_rate.sleep(); // keep timing consistent
    }

    return 0; // end program
}
